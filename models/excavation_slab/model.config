<?xml version="1.0"?>
<model>
  <name>excavation_slab</name>
  <version>1.0</version>
  <sdf version="1.7">excavation_slab.sdf</sdf>
  <description>
    Excavation pit, interior x [0, 10], y [5, 35], z [-10, 0], surrounded by a z = 0 apron. Both ends are open for 7 m; the
    middle, y [12, 28], is covered wall to wall by a low 0.3 m slab with its underside at z -6.5, on six 0.4 m columns, leaving
    3.5 m of clear height. Under it, two staggered walls 6.5 m long (from the left wall at y 15, from the right wall at y 25)
    leave 3.5 m gaps and hide part of the floor below from both open ends. Takeoff at (5, 2).
  </description>
</model>
