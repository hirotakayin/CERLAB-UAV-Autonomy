<?xml version="1.0" ?>
<!-- generated by scripts/make_cad_urdf.py from quadcopter_omni_lidar_cam.urdf and urdf/cerlab_lidar_drone (CAD) -->
<robot name="quadcopter" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="insta360_x" default="-0.0400"/> <!-- Insta360 X4 lens centre in base_link (m) -->
  <xacro:arg name="insta360_z" default="0.3440"/>
  <xacro:arg name="insta360_sideways" default="0"/> <!-- 1: lenses left (front lens, +y) and right, on the axis, leaned forward -->
  <xacro:property name="insta360_side_tilt_deg" value="55"/> <!-- sideways: turned about +y at the lens centre, top forward -->
  <xacro:arg name="lidar_downsample" default="2"/> <!-- Mid-360: use every n-th ray of its scan pattern; 4 halves the points and the cost -->
  <xacro:arg name="omni_ideal" default="1"/> <!-- 0 drops the ideal 360 depth sensor (/omni/cloud_raw) -->
  <xacro:arg name="lidar_pitch_deg" default="23.5"/> <!-- load with xacro (start_*.launch do) -->
  <!-- generated by scripts/make_omni_urdf.py: quadcopter_lidar.urdf + the ideal 360 depth sensor -->
  <link name="base_link">
    <inertial><mass value="1.54"/><origin rpy="0 0 0" xyz="0 0 0"/><inertia ixx="0.1152" ixy="0" ixz="0" iyy="0.1152" iyz="0" izz="0.218"/></inertial>
    <collision name="body"><origin xyz="-0.0001 -0.0001 0.0220" rpy="0 0 0"/><geometry><box size="0.5130 0.5132 0.2971"/></geometry></collision>
    <visual name="mount"><origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/><geometry><mesh filename="package://uav_simulator/urdf/cerlab_lidar_drone/meshes/gazebo/mount.obj"/></geometry><material name="cad_mount"><color rgba="0.61 0.13 0.15 1"/></material></visual>
    <visual name="camera"><origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/><geometry><mesh filename="package://uav_simulator/urdf/cerlab_lidar_drone/meshes/gazebo/camera.obj"/></geometry><material name="cad_camera"><color rgba="0.08 0.09 0.10 1"/></material></visual>
    <visual name="guards"><origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/><geometry><mesh filename="package://uav_simulator/urdf/cerlab_lidar_drone/meshes/gazebo/guards.obj"/></geometry><material name="cad_guards"><color rgba="0.33 0.35 0.37 1"/></material></visual>
    <visual name="props_0"><origin xyz="0.1468 0.1465 0.0355" rpy="0 0 0"/><geometry><mesh filename="package://uav_simulator/urdf/cerlab_lidar_drone/meshes/gazebo/props_0.obj"/></geometry><material name="cad_props"><color rgba="0.35 0.38 0.43 1"/></material></visual>
    <visual name="props_1"><origin xyz="0.1464 -0.1471 0.0355" rpy="0 0 0"/><geometry><mesh filename="package://uav_simulator/urdf/cerlab_lidar_drone/meshes/gazebo/props_1.obj"/></geometry><material name="cad_props"><color rgba="0.35 0.38 0.43 1"/></material></visual>
    <visual name="props_2"><origin xyz="-0.1469 -0.1467 0.0355" rpy="0 0 0"/><geometry><mesh filename="package://uav_simulator/urdf/cerlab_lidar_drone/meshes/gazebo/props_2.obj"/></geometry><material name="cad_props"><color rgba="0.35 0.38 0.43 1"/></material></visual>
    <visual name="props_3"><origin xyz="-0.1466 0.1468 0.0355" rpy="0 0 0"/><geometry><mesh filename="package://uav_simulator/urdf/cerlab_lidar_drone/meshes/gazebo/props_3.obj"/></geometry><material name="cad_props"><color rgba="0.35 0.38 0.43 1"/></material></visual>
    <visual name="frame"><origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/><geometry><mesh filename="package://uav_simulator/urdf/cerlab_lidar_drone/meshes/gazebo/frame.obj"/></geometry><material name="cad_frame"><color rgba="0.23 0.25 0.27 1"/></material></visual>
  </link>
  <!-- the LiDAR tilts about the front hinge of its mount; lidar_pitch_deg > 0 tips its top forward -->
  <link name="lidar_hinge">
    <visual name="lidar"><origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/><geometry><mesh filename="package://uav_simulator/urdf/cerlab_lidar_drone/meshes/gazebo/lidar.obj"/></geometry><material name="cad_lidar"><color rgba="0.90 0.91 0.93 1"/></material></visual>
    <visual name="lidar_bracket"><origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/><geometry><mesh filename="package://uav_simulator/urdf/cerlab_lidar_drone/meshes/gazebo/lidar_bracket.obj"/></geometry><material name="cad_lidar_bracket"><color rgba="0.61 0.13 0.15 1"/></material></visual>
    <visual name="lidar_adapter"><origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/><geometry><mesh filename="package://uav_simulator/urdf/cerlab_lidar_drone/meshes/gazebo/lidar_adapter.obj"/></geometry><material name="cad_lidar_adapter"><color rgba="0.17 0.19 0.21 1"/></material></visual>
    <visual name="lidar_links"><origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/><geometry><mesh filename="package://uav_simulator/urdf/cerlab_lidar_drone/meshes/gazebo/lidar_links.obj"/></geometry><material name="cad_lidar_links"><color rgba="0.61 0.13 0.15 1"/></material></visual>
    <inertial><mass value="0.001"/><origin xyz="0 0 0"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="lidar_tilt" type="fixed"><parent link="base_link"/><child link="lidar_hinge"/><origin xyz="0.02390 0.00000 0.08760" rpy="0 ${radians($(arg lidar_pitch_deg))} 0"/></joint>
  <link name="lidar_link"/>
  <joint name="lidar_mount" type="fixed"><parent link="lidar_hinge"/><child link="lidar_link"/><origin xyz="-0.04276 -0.00020 0.00932" rpy="0 0 0"/></joint>
  <!-- RealSense depth origin (assumed on its centreline, 4.2 mm behind the front glass), optical axes -->
  <link name="camera_link"/>
  <joint name="camera_mount" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.0598 0.0000 -0.0015" rpy="-1.5707963 0 -1.5707963"/></joint>
  <!-- Insta360 X4: omni_link at the lens centre, level; the X4 and its lens frames turned by insta360_sideways -->
  <link name="omni_link">
    <visual name="insta360_x4"><origin xyz="0 0 0" rpy="${float($(arg insta360_sideways)) * radians(insta360_side_tilt_deg)} 0 ${float($(arg insta360_sideways)) * pi / 2}"/><geometry><mesh filename="package://uav_simulator/urdf/cerlab_lidar_drone/meshes/gazebo/insta360_x4.obj"/></geometry><material name="cad_insta360_x4"><color rgba="0.07 0.07 0.08 1"/></material></visual>
    <inertial><mass value="0.001"/><origin xyz="0 0 0"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="insta360_mount" type="fixed"><parent link="base_link"/><child link="omni_link"/><origin xyz="${(1 - float($(arg insta360_sideways))) * float($(arg insta360_x))} 0 $(arg insta360_z)" rpy="0 0 0"/></joint>
  <link name="insta360_front"/>
  <joint name="insta360_front_lens" type="fixed"><parent link="omni_link"/><child link="insta360_front"/><origin xyz="0 0 0" rpy="${float($(arg insta360_sideways)) * radians(insta360_side_tilt_deg)} 0 ${float($(arg insta360_sideways)) * pi / 2}"/></joint>
  <link name="insta360_back"/>
  <joint name="insta360_back_lens" type="fixed"><parent link="omni_link"/><child link="insta360_back"/><origin xyz="0 0 0" rpy="${-float($(arg insta360_sideways)) * radians(insta360_side_tilt_deg)} 0 ${pi - float($(arg insta360_sideways)) * 3 * pi / 2}"/></joint>
  <!-- lidar_link is on the MID-360 mounting face: Livox's point-cloud origin above it is not applied yet (model_spec.json) -->

  <gazebo reference="quadcopter">
  	<material>quadcopter/Diffusion</material>
  </gazebo>




  <gazebo>
    <plugin name='quadcopter_gazebo_plugin' filename='libquadcopterPlugin.so'>
        <bodyName>base_link</bodyName>
        <rollpitchProportionalGain>10.0</rollpitchProportionalGain>
        <rollpitchDifferentialGain>5.0</rollpitchDifferentialGain>
        <rollpitchLimit>1.0</rollpitchLimit>
        <yawProportionalGain>1.5</yawProportionalGain>
        <yawDifferentialGain>1.0</yawDifferentialGain>
        <yawLimit>1.5</yawLimit>
        <yawAngleProportionalGain>3.0</yawAngleProportionalGain>
        <yawAngleLimit>3.15</yawAngleLimit>
        <velocityXYProportionalGain>5.0</velocityXYProportionalGain>
        <velocityXYDifferentialGain>2.3</velocityXYDifferentialGain>
        <velocityXYLimit>2</velocityXYLimit>
        <velocityZProportionalGain>5.0</velocityZProportionalGain>
        <velocityZDifferentialGain>0.5</velocityZDifferentialGain>
        <velocityZLimit>-1</velocityZLimit>
        <positionXYProportionalGain>1.2</positionXYProportionalGain>
        <positionXYDifferentialGain>0.1</positionXYDifferentialGain>
        <positionXYIntegralGain>0.0</positionXYIntegralGain>
        <positionXYLimit>-1</positionXYLimit>
        <positionZProportionalGain>1.0</positionZProportionalGain>
        <positionZDifferentialGain>0.2</positionZDifferentialGain>
        <positionZLimit>-1</positionZLimit>
        <accelerationXYProportionalGain>15.0</accelerationXYProportionalGain>
        <accelerationXYDifferentialGain>0.0</accelerationXYDifferentialGain>
        <accelerationXYIntegralGain>0.0</accelerationXYIntegralGain>
        <accelerationXYLimit>-1</accelerationXYLimit>
        <accelerationZProportionalGain>0.5</accelerationZProportionalGain>
        <accelerationZDifferentialGain>0.0</accelerationZDifferentialGain>
        <accelerationZLimit>-1</accelerationZLimit>
        <maxForce>60</maxForce>
        <motionSmallNoise>0.05</motionSmallNoise>
        <motionDriftNoise>0.03</motionDriftNoise>
        <motionDriftNoiseTime>5.0</motionDriftNoiseTime>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
      <sensor name="camera" type="depth">
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.047198</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>7.0</far>
            </clip>
          </camera>
          <pose>0.0598 0.0000 -0.0015 0 0 0</pose> <!-- CAD RealSense depth origin -->
          <plugin name="camera_plugin" filename="libgazebo_ros_openni_kinect.so">
            <baseline>0.2</baseline>
            <alwaysOn>true</alwaysOn>
            <updateRate>0.0</updateRate>
            <cameraName>camera_ir</cameraName>
            <imageTopicName>/camera/color/image_raw</imageTopicName>
            <cameraInfoTopicName>/camera/color/camera_info</cameraInfoTopicName>
            <depthImageTopicName>/camera/depth/image_raw</depthImageTopicName>
            <depthImageInfoTopicName>/camera/depth/camera_info</depthImageInfoTopicName>
            <pointCloudTopicName>/camera/depth/points</pointCloudTopicName>
            <frameName>camera_link</frameName>
            <pointCloudCutoff>0.05</pointCloudCutoff>
            <distortionK1>0</distortionK1>
            <distortionK2>0</distortionK2>
            <distortionK3>0</distortionK3>
            <distortionT1>0</distortionT1>
            <distortionT2>0</distortionT2>
            <CxPrime>0</CxPrime>
            <Cx>0</Cx>
            <Cy>0</Cy>
            <focalLength>0</focalLength>
            <hackBaseline>0</hackBaseline>
          </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="base_link">
    <sensor type="ray" name="laser_livox">
        <pose>${0.02390 + cos(radians($(arg lidar_pitch_deg))) * -0.04276 + sin(radians($(arg lidar_pitch_deg))) * 0.00932} -0.00020 ${0.08760 - sin(radians($(arg lidar_pitch_deg))) * -0.04276 + cos(radians($(arg lidar_pitch_deg))) * 0.00932} 0 ${radians($(arg lidar_pitch_deg))} 0</pose> <!-- Mid-360 pitched nose-down (xacro arg lidar_pitch_deg, 23.5 on the real drone) -->
        <visualize>true</visualize>
        <always_on>True</always_on>
        <update_rate>10</update_rate>
        <!-- This ray plgin is only for visualization. -->
        <plugin name="gazebo_ros_laser_controller" filename="liblivox_laser.so">
			  <ray>
			  <scan>
				  <horizontal>
				    <samples>100</samples>
				    <resolution>1</resolution>
				    <min_angle>-3.1415926535897931</min_angle>
            <max_angle>3.1415926535897931</max_angle>
				  </horizontal>
				  <vertical>
				    <samples>50</samples>
				    <resolution>1</resolution>
				    <min_angle>-3.1415926535897931</min_angle>
            <max_angle>3.1415926535897931</max_angle>
				  </vertical>
			  </scan>
			  <range>
				  <min>0.1</min>
				  <max>40</max>
				  <resolution>1</resolution>
			  </range>
			  <noise>
				  <type>gaussian</type>
				  <mean>0.0</mean>
				  <stddev>0.0</stddev>
			  </noise>
			  </ray>
          <visualize>false</visualize>
		      <samples>20000</samples>
		      <downsample>$(arg lidar_downsample)</downsample>
		      <csv_file_name>mid360-real-centr.csv</csv_file_name>
          <publish_pointcloud_type>2</publish_pointcloud_type>
		      <!-- <ros_topic>/livox/lidar</ros_topic> -->
          <ros_topic>/cloud_registered_body</ros_topic>
          <frameName>lidar_link</frameName> <!-- points are in the tilted sensor frame; base_link -> lidar_link comes from this URDF (robot_state_publisher) -->
        </plugin>
      </sensor>  
  </gazebo>

  <gazebo reference="base_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/livox/imu</remapping>
        </ros>
        <updateRateHZ>300.0</updateRateHZ>
        <gaussianNoise>0.0</gaussianNoise>
        <xyzOffset>0 0 0</xyzOffset>
        <rpyOffset>0 0 0</rpyOffset>
        <frameName>base_link</frameName>
        <topicName>/livox/imu</topicName>
        <initialOrientationAsReference>false</initialOrientationAsReference>
      </plugin>
      <always_on>true</always_on>
      <update_rate>300</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <xacro:if value="$(arg omni_ideal)">
  <gazebo reference="base_link">
    <sensor type="ray" name="omni360_ideal">
        <pose>${(1 - float($(arg insta360_sideways))) * float($(arg insta360_x))} 0 $(arg insta360_z) 0 0 0</pose> <!-- ideal 360 depth at the Insta360 position: level, on a mast above the lidar -->
        <visualize>true</visualize>
        <always_on>True</always_on>
        <update_rate>10</update_rate>
        <!-- This ray plgin is only for visualization. -->
        <plugin name="gazebo_ros_laser_controller" filename="liblivox_laser.so">
			  <ray>
			  <scan>
				  <horizontal>
				    <samples>100</samples>
				    <resolution>1</resolution>
				    <min_angle>-3.1415926535897931</min_angle>
            <max_angle>3.1415926535897931</max_angle>
				  </horizontal>
				  <vertical>
				    <samples>50</samples>
				    <resolution>1</resolution>
				    <min_angle>-3.1415926535897931</min_angle>
            <max_angle>3.1415926535897931</max_angle>
				  </vertical>
			  </scan>
			  <range>
				  <min>0.6</min>
				  <max>25</max>
				  <resolution>1</resolution>
			  </range>
			  <noise>
				  <type>gaussian</type>
				  <mean>0.0</mean>
				  <stddev>0.0</stddev>
			  </noise>
			  </ray>
          <visualize>false</visualize>
		      <samples>20000</samples>
		      <downsample>2</downsample>
		      <csv_file_name>omni360-ideal.csv</csv_file_name>
          <publish_pointcloud_type>2</publish_pointcloud_type>
		      <!-- <ros_topic>/livox/lidar</ros_topic> -->
          <ros_topic>/omni/cloud_raw</ros_topic>
          <frameName>omni_link</frameName> <!-- level, 0.24 m above base_link; published in setupTF.launch -->
        </plugin>
      </sensor>  
  </gazebo>
  </xacro:if>
  <gazebo reference="base_link">
    <sensor name="insta360_front" type="wideanglecamera">
      <pose>${(1 - float($(arg insta360_sideways))) * float($(arg insta360_x))} 0 $(arg insta360_z) ${float($(arg insta360_sideways)) * radians(insta360_side_tilt_deg)} 0 ${float($(arg insta360_sideways)) * pi / 2}</pose>
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>3.4907</horizontal_fov>
        <image><width>640</width><height>640</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>100</far></clip>
        <lens><type>equidistant</type><scale_to_hfov>true</scale_to_hfov><cutoff_angle>1.7453</cutoff_angle><env_texture_size>512</env_texture_size></lens>
      </camera>
      <plugin name="insta360_front_ros" filename="libgazebo_ros_camera.so">
        <cameraName>insta360/front</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>insta360_front</frameName>
        <updateRate>0</updateRate>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="insta360_back" type="wideanglecamera">
      <pose>${(1 - float($(arg insta360_sideways))) * float($(arg insta360_x))} 0 $(arg insta360_z) ${-float($(arg insta360_sideways)) * radians(insta360_side_tilt_deg)} 0 ${pi - float($(arg insta360_sideways)) * 3 * pi / 2}</pose>
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>3.4907</horizontal_fov>
        <image><width>640</width><height>640</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>100</far></clip>
        <lens><type>equidistant</type><scale_to_hfov>true</scale_to_hfov><cutoff_angle>1.7453</cutoff_angle><env_texture_size>512</env_texture_size></lens>
      </camera>
      <plugin name="insta360_back_ros" filename="libgazebo_ros_camera.so">
        <cameraName>insta360/back</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>insta360_back</frameName>
        <updateRate>0</updateRate>
      </plugin>
    </sensor>
  </gazebo>
</robot>
