<launch>
	<arg name="pose_topic" default="/CERLAB/quadcopter/pose"/>
	<arg name="lidar_pitch_deg" default="23.5"/>  <!-- the Mid-360's nose-down tilt (23.5 on the real drone) -->
	<arg name="lidar_pitch_rad" value="$(eval float(arg('lidar_pitch_deg')) * 3.141592653589793 / 180)"/>
	<node name="quadcopterTF" pkg="uav_simulator" type="quadcopterTFBroadcaster" args="$(arg pose_topic)" output="screen"/>
	<!-- lidar_tf:=false when the URDF carries the sensor joints (CAD drones: robot_state_publisher publishes
	     lidar_link, camera_link and omni_link -> insta360_front|back from the URDF, so none of the fixed offsets below) -->
	<arg name="lidar_tf" default="true"/>
	<node if="$(arg lidar_tf)" pkg="tf" type="static_transform_publisher" name="baselink_cameralink"
      args="0.09 0.0 0.095 -1.57 0 -1.57 base_link camera_link 1000" />
	<!-- Mid-360 in quadcopter_lidar.urdf: 0.13 m up, pitched lidar_pitch_deg nose-down (args: x y z yaw pitch roll) -->
	<node if="$(arg lidar_tf)" pkg="tf" type="static_transform_publisher" name="baselink_lidarlink"
      args="0 0 0.13 0 $(arg lidar_pitch_rad) 0 base_link lidar_link 1000" />
	<!-- ideal 360 depth sensor in quadcopter_omni.urdf (sensor:=omni): level, 0.24 m up, where the Insta360 sits -->
	<group if="$(arg lidar_tf)">
	<node pkg="tf" type="static_transform_publisher" name="baselink_omnilink"
      args="0 0 0.24 0 0 0 base_link omni_link 1000" />
	<node pkg="tf" type="static_transform_publisher" name="omni_insta360_front" args="0 0 0 0 0 0 omni_link insta360_front 1000" />
	<node pkg="tf" type="static_transform_publisher" name="omni_insta360_back" args="0 0 0 3.14159265 0 0 omni_link insta360_back 1000" />
	</group>
</launch>
