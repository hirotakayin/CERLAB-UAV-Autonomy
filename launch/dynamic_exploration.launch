<launch>
	<!-- 1. Fix missing leading slashes for CERLAB topics -->
	<remap from="/mavros/local_position/odom" to="/CERLAB/quadcopter/odom" />
	<remap from="/mavros/local_position/pose" to="/CERLAB/quadcopter/odom" />
	<remap from="/mavros/setpoint_raw/local" to="/CERLAB/quadcopter/cmd_acc" />

	<rosparam file="$(find tracking_controller)/cfg/controller_param.yaml" ns="controller"/>
	<node pkg="tracking_controller" type="tracking_controller_node" name="tracking_controller_node" output="screen" />

	<rosparam file="$(find autonomous_flight)/cfg/dynamic_inspection/fake_detector_param.yaml" />
	<rosparam file="$(find autonomous_flight)/cfg/dynamic_exploration/flight_base.yaml" ns="autonomous_flight"/>
	<rosparam file="$(find autonomous_flight)/cfg/dynamic_exploration/exploration_param.yaml" ns="DEP"/>
	<rosparam file="$(find autonomous_flight)/cfg/dynamic_exploration/planner_param.yaml" />
	<rosparam file="$(find autonomous_flight)/cfg/dynamic_exploration/dynamic_detector_param.yaml" ns="/onboard_detector" />
	<rosparam file="$(find autonomous_flight)/cfg/dynamic_exploration/mapping_param.yaml" ns="/dynamic_map" />

	<!-- Which pit: excavation1, excavation_long or excavation_slab. Start the matching sim: start_<map>.launch -->
	<arg name="map" default="excavation1"/>
	<rosparam file="$(find autonomous_flight)/cfg/dynamic_exploration/maps/$(arg map).yaml"/>
	<rosparam file="$(find autonomous_flight)/cfg/dynamic_exploration/maps/$(arg map)_mapping.yaml" ns="/dynamic_map"/>

	<!-- Which method to fly, loaded over the configs above: baseline, gain or tour. Runs on another map are named map_preset -->
	<arg name="preset" default="gain"/>
	<rosparam file="$(find autonomous_flight)/cfg/dynamic_exploration/presets/$(arg preset).yaml"/>
	<param name="autonomous_flight/preset" value="$(eval arg('preset') if arg('map') == 'excavation1' else arg('map') + '_' + arg('preset'))"/>

	<node pkg="autonomous_flight" type="throttle_topics.sh" name="throttle_topics" />

	<!-- The dashboard draws the pit wireframe from this -->
	<arg name="world_sdf" default="$(eval find('uav_simulator') + '/models/' + arg('map') + '/' + ('env_one.sdf' if arg('map') == 'excavation1' else arg('map') + '.sdf'))"/>
	<param name="autonomous_flight/world_sdf" textfile="$(arg world_sdf)"/>

	<!-- Mission dashboard (needs ros-noetic-rosbridge-suite). gui:=false to skip -->
	<arg name="gui" default="true"/>
	<group if="$(arg gui)">
		<include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch"/>
		<node pkg="autonomous_flight" type="system_monitor.py" name="system_monitor"/>
		<node pkg="autonomous_flight" type="recording_fixer.py" name="recording_fixer"/>
		<node pkg="autonomous_flight" type="open_mission_gui.sh" name="open_mission_gui"/>
	</group>

	<!-- RViz for debugging: lidar scan, voxel map, DEP roadmap / candidate paths / frontiers -->
	<arg name="rviz" default="false"/>
	<node if="$(arg rviz)" pkg="rviz" type="rviz" name="exploration_rviz" args="-d $(find autonomous_flight)/rviz/excavation_exploration.rviz"/>

	<node pkg="autonomous_flight" type="dynamic_exploration_node" name="dynamic_exploration_node" output="screen">
		<!-- 2. Direct depth topic remapping to bypass throttle_topics mismatch -->
		<remap from="/camera/aligned_depth_to_color/image_raw_t" to="/camera/depth/image_raw"/>
		<remap from="/camera/color/image_raw_t" to="/camera/color/image_raw"/>
	</node>
</launch>